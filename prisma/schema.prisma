// Prisma schema for N2K Labs agency website
// Turso (libSQL) — works on Vercel and locally.
//
// The schema provider is "sqlite" because Turso's libSQL is SQLite-compatible.
// The actual Turso connection (libsql://... URL + auth token) is wired up in
// src/lib/db.ts via the @prisma/adapter-libsql driver adapter — that's where
// the libsql:// protocol is actually parsed.
//
// HOW TO SET UP:
// 1. Create a Turso database: https://turso.tech → app → New database
// 2. Get the connection URL and auth token from the database's "Settings" page
// 3. Set DATABASE_URL in .env (local) AND Vercel env vars (production):
//      DATABASE_URL="libsql://<db-name>-<your-handle>.turso.io?authToken=<token>"
// 4. Run `bun run db:push` to create tables
// 5. Run `bun run db:seed` to populate default content

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  client      String
  category    String   // e.g. "Web Development", "E-Commerce", "Brand Identity"
  description String
  challenge   String?
  solution    String?
  result      String?
  url         String?
  image       String?  // primary / cover image (backward compat)
  images      String   @default("[]") // JSON array of base64 data URLs (or paths)
  gallery     String?  // JSON array of image paths (legacy)
  tags        String?  // JSON array of strings
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  features    String?  // JSON array of strings
  icon        String?   // lucide icon name
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String?
  quote     String
  rating    Int      @default(5)
  avatar    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stat {
  id      String @id @default(cuid())
  label   String
  value   Int
  suffix  String?
  order   Int    @default(0)
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  service   String?
  budget    String?
  message   String
  status    String   @default("new") // new | read | replied | archived
  createdAt DateTime @default(now())
}
